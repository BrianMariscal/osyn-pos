{
  "name": "abarrotes-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy:cf": "npm run build && wrangler pages deploy dist --branch main"
  },
  "dependencies": {
    "@sentry/browser": "^10.76.1",
    "@zxing/browser": "^0.2.1",
    "idb-keyval": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "wrangler": "^4.148.0"
  }
}
